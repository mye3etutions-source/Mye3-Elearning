<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Redirect /api requests to the backend (Optional if handled by cPanel, but good as fallback)
  # RewriteRule ^api/(.*)$ /backend/$1 [L]

  # For React Routing: If the requested resource is not a file or directory, handle it with index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
